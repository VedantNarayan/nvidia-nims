{
  "name": "nvidia-nims",
  "productName": "Nvidia Nims",
  "version": "1.0.0",
  "description": "Native macOS menu bar client for managing and monitoring local Nvidia NIMS proxy connections.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --mac dmg",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.nvidia.nims.macos",
    "productName": "Nvidia Nims",
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg"
      ],
      "icon": "NVIDIAIcon.icns"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "license": "ISC",
  "type": "commonjs"
}